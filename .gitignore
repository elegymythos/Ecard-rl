# ============================================================
# .gitignore 语法速查
#   # 注释
#   __pycache__/            匹配任意层级下名为 __pycache__ 的目录（含子目录）
#   /dist/                  只匹配仓库根目录下的 dist/（斜杠开头 = 锚定根）
#   *.pyc                   匹配任意层级的 .pyc 文件
#   !keep.csv               排除上述规则：keep.csv 照常入库（必须写在覆盖规则之后）
#   规则从上到下匹配，后写的覆盖先写的
# ============================================================

# ---- Python 运行时产物（可再生成，一律不入库）----
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.coverage
htmlcov/

# ---- 虚拟环境（本机专属，绝不入库）----
.venv/
venv/
env/
ENV/

# ---- 训练/实验产物（大文件、可再生成）----
data/checkpoints/            # 检查点：每 5000 回合覆盖，可从 checkpoint 恢复
data/*.png                   # 训练结束自动导出的结果图
swanlog/                     # SwanLab 本地运行数据 + 自动图表/CSV/诊断
run-*/                       # 旧版根目录的 SwanLab run 目录
PPO_Opponent_Modeling-*.txt
*.log
nohup.out

# 注意：data/ 本身不忽略——将来的人类对局原始数据（阶段5）要入库。
# 原则是「忽略生成物、保留原始数据」，别把整目录一刀切。

# ---- 测试与工具缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- 编辑器 / 操作系统（个人习惯，不入库）----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- 环境变量 / 密钥（含密码或 token 时）----
.env
.env.*

direction.md
Question.md