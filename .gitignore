data/checkpoints/
# 结果图（训练结束自动生成）
data/*.png
# SwanLab 本地运行数据与自动导出的图表/CSV/诊断
swanlog/
# 根目录的历史 SwanLab run 目录（旧版本路径）
run-*/
# 历史终端日志
PPO_Opponent_Modeling-*.txt
*.log
nohup.out

